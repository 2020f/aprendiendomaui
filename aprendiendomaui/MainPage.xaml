<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:aprendiendomaui"
             x:Class="aprendiendomaui.MainPage"
             Title="Control RRHH"
             BackgroundColor="#F4F7FB">

    <ContentPage.Resources>
        <Style x:Key="PanelTitle" TargetType="Label">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#172033" />
        </Style>

        <Style x:Key="MutedText" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#657085" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E2E8F0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">
            <Border StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Padding="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#13213B" Offset="0" />
                        <GradientStop Color="#0F766E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="8">
                    <Label Text="Control de empleados"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Border Grid.Column="1"
                            Padding="10,6"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            BackgroundColor="#E0F2FE"
                            VerticalOptions="Start">
                        <Label Text="Demo MAUI"
                               FontAttributes="Bold"
                               TextColor="#075985" />
                    </Border>
                    <Label Grid.Row="1"
                           Text="Registro rapido, asistencia diaria e historial en una sola pantalla."
                           TextColor="#D9E7F2"
                           FontSize="15" />
                    <Grid Grid.Row="2"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="10"
                          Margin="0,12,0,0">
                        <Border Padding="12"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#3B82F6"
                                StrokeThickness="1"
                                BackgroundColor="#0F172A">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="HeroEmployeeCountLabel"
                                       Text="0"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Empleados"
                                       TextColor="#BAE6FD"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                Padding="12"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#2DD4BF"
                                StrokeThickness="1"
                                BackgroundColor="#134E4A">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="HeroAttendanceCountLabel"
                                       Text="0"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Marcas"
                                       TextColor="#CCFBF1"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="12"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#A78BFA"
                                StrokeThickness="1"
                                BackgroundColor="#312E81">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hoy"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="TodayLabel"
                                       TextColor="#DDD6FE"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.15*,0.85*"
                  ColumnSpacing="16"
                  RowDefinitions="Auto,Auto">
                <Border Style="{StaticResource PanelBorder}">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Nuevo empleado"
                               Style="{StaticResource PanelTitle}" />
                        <Label Text="Completa los datos basicos para agregarlo al registro."
                               Style="{StaticResource MutedText}" />

                        <Entry x:Name="NameEntry"
                               Placeholder="Nombre completo"
                               ReturnType="Next" />
                        <Entry x:Name="RoleEntry"
                               Placeholder="Cargo"
                               ReturnType="Next" />
                        <Entry x:Name="DepartmentEntry"
                               Placeholder="Departamento"
                               ReturnType="Done" />

                        <Button Text="Agregar empleado"
                                BackgroundColor="#0F766E"
                                Clicked="OnAddEmployeeClicked" />

                        <Label x:Name="FormMessageLabel"
                               TextColor="#0F766E"
                               FontAttributes="Bold"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource PanelBorder}">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Marcar asistencia"
                               Style="{StaticResource PanelTitle}" />
                        <Label Text="Selecciona empleado, fecha y estado."
                               Style="{StaticResource MutedText}" />

                        <Picker x:Name="EmployeePicker"
                                Title="Selecciona un empleado" />
                        <DatePicker x:Name="AttendanceDatePicker" />

                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="8">
                            <Button Text="Presente"
                                    BackgroundColor="#16A34A"
                                    Clicked="OnPresentClicked" />
                            <Button Grid.Row="1"
                                    Text="Tarde"
                                    BackgroundColor="#D97706"
                                    Clicked="OnLateClicked" />
                            <Button Grid.Row="2"
                                    Text="Ausente"
                                    BackgroundColor="#DC2626"
                                    Clicked="OnAbsentClicked" />
                        </Grid>

                        <Label x:Name="AttendanceMessageLabel"
                               TextColor="#0F766E"
                               FontAttributes="Bold"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Empleados registrados"
                                   Style="{StaticResource PanelTitle}" />
                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#ECFDF5"
                                    Stroke="#BBF7D0">
                                <Label x:Name="EmployeeCountLabel"
                                       Text="0"
                                       FontAttributes="Bold"
                                       TextColor="#047857" />
                            </Border>
                        </Grid>

                        <CollectionView x:Name="EmployeesCollection"
                                        EmptyView="Aun no hay empleados registrados.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:Employee">
                                    <Border Padding="14"
                                            Margin="0,0,0,8"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="White"
                                            Stroke="#CBD5E1">
                                        <Grid ColumnDefinitions="52,*"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="3">
                                            <Border Grid.RowSpan="3"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeShape="RoundRectangle 8"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#0F766E"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding Initials}"
                                                       TextColor="White"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="17"
                                                   TextColor="#0F172A" />
                                            <Label Grid.Column="1"
                                                   Grid.Row="1"
                                                   Text="{Binding Detail}"
                                                   TextColor="#475569"
                                                   FontSize="13" />
                                            <Grid Grid.Column="1"
                                                  Grid.Row="2"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="8"
                                                  Margin="0,5,0,0">
                                                <Label Text="Ultima marca"
                                                       TextColor="#64748B"
                                                       FontSize="12" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding LastAttendance}"
                                                       TextColor="#0F766E"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Historial de asistencia"
                               Style="{StaticResource PanelTitle}" />

                        <CollectionView x:Name="AttendanceCollection"
                                        EmptyView="Todavia no hay asistencia registrada.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:AttendanceRecord">
                                    <Border Padding="0"
                                            Margin="0,0,0,8"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="White"
                                            Stroke="#CBD5E1">
                                        <Grid ColumnDefinitions="6,86,*"
                                              ColumnSpacing="12">
                                            <BoxView BackgroundColor="#0F766E"
                                                     CornerRadius="8,0,8,0" />

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Padding="0,12"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding DayText}"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding MonthText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>

                                            <Grid Grid.Column="2"
                                                  Padding="0,12,14,12"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <Label Text="{Binding EmployeeName}"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="#0F172A" />
                                                <Label Grid.Row="1"
                                                       Text="{Binding DateText}"
                                                       TextColor="#64748B"
                                                       FontSize="12" />
                                                <Border Grid.Column="1"
                                                        Grid.RowSpan="2"
                                                        Padding="10,5"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#0F172A"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           TextColor="White"
                                                           FontAttributes="Bold"
                                                           FontSize="12" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
